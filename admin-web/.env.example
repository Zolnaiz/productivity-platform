# Web build settings. VITE_API_URL is where the browser sends API calls; /api is proxied by nginx (or the
# Vite dev server) to the backend.

VITE_API_URL=/api
VITE_APP_NAME=Productivity Platform Admin
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Demo mode is always available in Vite development.
# Set this to true only for an intentional production demo build.
VITE_ENABLE_DEMO_MODE=false
