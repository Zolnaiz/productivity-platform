# Application Configuration
APP_NAME="Productivity Platform"
APP_VERSION="1.0.0"
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"

# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="postgres"
DB_DATABASE="questionnaire_db"
DB_SYNCHRONIZE="false"
DB_LOGGING="false"
DB_SSL="false"
DB_MIGRATIONS_RUN="true"

# Local demo smoke option:
# Set DB_SYNCHRONIZE="true" and ALLOW_PUBLIC_OPERATIONS="true" only for throwaway local databases.

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Security Configuration
BCRYPT_ROUNDS=10
CORS_ORIGINS="http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173"
ENABLE_SWAGGER="false"
ALLOW_PUBLIC_OPERATIONS="false"
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# Attachments — photographs and documents on red tags, zones and audits.
#
# `local` writes to UPLOAD_DIR, which is right for one machine with a real
# volume mounted there. `s3` keeps the bytes in an object store, which is what
# survives a container being replaced; S3_ENDPOINT points it at MinIO or Ceph
# on your own hardware, and empty credentials fall back to the SDK's chain
# (an instance role, a mounted credentials file).
#
# What may be uploaded and how large it may be are decided in code, from the
# bytes themselves rather than from what a client claims: see
# backend/src/operations/attachment-storage.ts.
ATTACHMENT_STORE="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY="

# Mail — how anything reaches somebody who is not looking at the application.
#
# `log` writes the recipient and the subject and sends nothing, which is right
# for a deployment with no mail server: the in-app inbox is the record and an
# email is an addition to it. `smtp` sends, and then needs MAIL_FROM and
# SMTP_HOST. Empty credentials mean an unauthenticated relay on your own
# network, which is a normal arrangement inside a plant.
#
# APP_BASE_URL is what makes a link clickable: without it an invitation carries
# a bare code and a notification carries no link at all.
MAIL_TRANSPORT="log"
APP_BASE_URL=""
MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD="

# Redis Configuration (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL=3600

# Monitoring Configuration (Optional)
SENTRY_DSN=""
ENABLE_METRICS="false"
METRICS_PORT=9090

# Third-party Services (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Feature Flags
ENABLE_REGISTRATION="true"
ENABLE_EMAIL_VERIFICATION="false"
ENABLE_SOCIAL_LOGIN="false"
ENABLE_TWO_FACTOR="false"
ENABLE_API_DOCS="true"

# Business Rules
MAX_QUESTIONNAIRES_PER_ORG=100
MAX_QUESTIONS_PER_QUESTIONNAIRE=50
MAX_EXPENSE_AMOUNT=1000000000
REPORT_RETENTION_DAYS=365
PASSWORD_MIN_LENGTH=8

# How long an audit entry is kept, in days. Two years by default: a quality
# programme is reviewed annually and argued about the year after. Zero keeps
# everything for ever, and has to be set on purpose — leaving this unset gives
# the default, not "keep everything".
AUDIT_LOG_RETENTION_DAYS=730

# Logging Configuration
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"
LOG_MAX_FILES=14
LOG_MAX_SIZE="20m"
