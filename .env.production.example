DB_USERNAME=productivity_prod
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=productivity_prod
# Published on loopback only, for the seed, psql and the backup. A server that
# already runs PostgreSQL owns 5432 and Docker Desktop will not refuse the
# clash, so anything you then run from the host quietly talks to the wrong
# database. Pick a free port if 5432 is taken.
DB_PORT=5432

API_PORT=3000
WEB_PORT=3001

# `/api` is the single-host setup this compose file builds: nginx serves the
# application and proxies /api to the backend container, so browser and API
# share one origin and CORS_ORIGINS never comes into it. Baked in at build
# time, so changing it needs `build admin-web`, not just a restart.
#
# Split the two across hostnames instead and this becomes the full API URL —
# https://api.example.com/api — and CORS_ORIGINS has to name the origin the
# application is served from, or every call is blocked by the browser.
VITE_API_URL=/api
CORS_ORIGINS=https://app.example.com
VITE_ENABLE_DEMO_MODE=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters-or-leave-empty
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

DB_MIGRATIONS_RUN=true
DB_LOGGING=false
DB_SSL=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
ENABLE_METRICS=false

# Where attachment bytes live. `local` uses the volume the compose file
# mounts at /app/uploads, which survives this container being replaced but not
# the host; `s3` keeps them in an object store, and S3_ENDPOINT points that at
# MinIO or Ceph on your own hardware. Photographs are a 5S programme's
# evidence — whichever is chosen has to be in the backup.
ATTACHMENT_STORE=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty: path-style addressing whenever S3_ENDPOINT is set, which MinIO needs.
S3_FORCE_PATH_STYLE=

# How anything reaches somebody who is not looking at the application. `log`
# sends nothing and writes the recipient and the subject — the in-app inbox
# still works — and `smtp` needs MAIL_FROM and SMTP_HOST. APP_BASE_URL is what
# makes a link in an invitation clickable.
MAIL_TRANSPORT=log
APP_BASE_URL=https://app.example.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# Empty: TLS from the first byte on port 465, STARTTLS otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# The organization's clock. Monthly reports count months on it and the
# morning reminder is sent by it; the containers themselves run on UTC.
APP_TIME_ZONE=Asia/Ulaanbaatar

# What runs on its own. Each morning at REMINDER_HOUR in APP_TIME_ZONE
# everybody with work due today or already late gets one reminder (emailed
# too when MAIL_TRANSPORT=smtp). Last month's report is closed on the fifth,
# after which it no longer changes; a manager can close it sooner. Set any of
# these to false to switch that job off.
ENABLE_AUDIT_SCHEDULER=true
ENABLE_MONTH_CLOSE=true
ENABLE_DAILY_REMINDERS=true
REMINDER_HOUR=8

# The audit trail - who changed what, and when - is kept this many days and
# then deleted: two years by default. Set 0 to keep it for ever, if a
# regulator or the organization's own archive rules require it. Tasks, closed
# monthly reports, audits and floor-plan versions are kept regardless.
AUDIT_LOG_RETENTION_DAYS=730

REDIS_PASSWORD=replace-with-a-long-random-redis-password
GRAFANA_PASSWORD=replace-with-a-long-random-grafana-password
BACKUP_SCHEDULE=@daily
